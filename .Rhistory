# Load library
library(sf) # spatial data, for geojson
library(dplyr) # filter data
library(corrplot) # For calculating the matrix
library(ggplot2) # For plotting the base heatmap
library(plotly)  # For interactivity
library(tidyr) # For data wrangling
library(glmnet)
library(Matrix) # Used by glmnet
library(rpart)
library(rpart.plot)
dt_model <- rpart(
formula,
data = lm_df,
method = "anova",
control = rpart.control(cp = 0.001) # Optionally lower complexity parameter for a larger tree
)
# --- 5. Print the Text Summary and Model Details ---
print("--- Text Summary of Decision Tree Splits ---")
print(dt_model)
rpart.plot(dt_model,
type = 4,           # Draw the split labels closer to the split
extra = 1,          # Display the number of observations at the node
main = "Simple Regression Decision Tree for Female Employment Rate",
box.palette = "Blues",
shadow.col = "gray"
)
help(rpart)
dt_model$y
# 1. Get the predicted value for every observation in the training data
predictions <- predict(dt_model, newdata = lm_df)
# 2. Extract the unique predicted values.
# In a regression tree, each unique prediction corresponds to a terminal node mean.
terminal_node_means <- unique(predictions)
# 3. Print the results
cat("--- Mean Female Employment Rate (Node Prediction) ---\n")
print(terminal_node_means)
cat("----------------------------------------------------\n")
dt_model$where
dt_model$terms
dt_model$splits
dt_model$ordered
dt_model$variable.importance
